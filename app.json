{
  "expo": {
    "name": "PantryScout",
    "slug": "pantryscout",
    "version": "0.1.0",
    "scheme": "pantryscout",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#F7F5EF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.andreipath26.pantryscout"
    },
    "android": {
      "package": "com.andreipath26.pantryscout",
      "blockedPermissions": [
        "android.permission.ACCESS_LOCAL_NETWORK",
        "android.permission.NEARBY_WIFI_DEVICES",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F7F5EF"
      }
    },
    "plugins": [
      "./plugins/withPantryLocalAI",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PantryScout to scan groceries and receipts.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow PantryScout to photograph groceries and receipts.",
          "microphonePermission": false,
          "photosPermission": "Allow PantryScout to analyze a grocery or fridge photo you choose."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1
          },
          "androidIntentFilters": ["text/*"]
        }
      ]
    ],
    "web": {
      "bundler": "metro"
    }
  }
}
